# Claude Code local settings.
# These record machine-specific paths (Windows username, the location of the
# private Obsidian vault) and tool permissions. Nothing secret, but nothing that
# belongs in a public repo either — and settings.local.json is local by design.
.claude/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# Dependencies (none today — the project vendors phaser.js directly — but this
# keeps an accidental `npm install` out of the repo)
node_modules/

# Audio/art masters. Source files are large and are not what the game loads;
# keep the exported .ogg/.mp3/.png/.webp, keep the masters out.
*.wav
!assets/audio/*.wav
*.aup3
*.rpp
*.rpp-bak
*.psd
*.kra
*.xcf

# Scratch
/tmp/
*.log

# Loading-screen master art. The game ships the 1280x720 .webp beside it
# (85% smaller, visually lossless at PSNR 44dB); this full-res PNG is the
# source to re-export from and would sit in git history forever if committed.
assets/UIinterface/ruins_LoadScreen.png

# Python bytecode (the patch-notes script runs in CI, never from here)
__pycache__/
*.pyc

# Krita writes a .png~ backup beside any edited asset
*.png~
